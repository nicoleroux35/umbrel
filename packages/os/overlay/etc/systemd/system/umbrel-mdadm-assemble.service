[Unit]
Description=Assemble mdadm Linux RAID arrays before Umbrel starts
Documentation=man:mdadm(8)
DefaultDependencies=no
After=local-fs.target
Before=umbrel.service umbrel-custom-pre-start.service
Wants=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Assemble arrays from superblocks without blocking boot when no array exists
# (mdadm exits non-zero in that case). Mounting the arrays is umbreld's job: it
# records the desired mounts in its data directory and replays them on start,
# because /etc — where an fstab entry would go — does not survive a reboot.
ExecStart=/bin/sh -c 'mdadm --assemble --scan --run || true'
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
